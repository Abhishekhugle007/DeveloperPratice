{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",

    "rootDir": "./",
    "outDir": "./output",

    "strict": true,

    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,

    "skipLibCheck": true
  },
  "include": [
    "*.ts"
  ],
