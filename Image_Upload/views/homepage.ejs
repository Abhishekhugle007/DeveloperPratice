
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student File Upload</title>
</head>
<body>
    <form action="/student/create" method="POST" enctype="multipart/form-data">
        <input type="text" name="name" placeholder="Enter name" required><br>
        <br>
        <input type="number" name="age" placeholder="Enter age" required><br>
            <br>

        <input type="email" name="email" placeholder="Enter email" required><br>
            <br>
        <input type="text" name="phone" placeholder="Enter phone" required><br>
            <br>
        <input type="text" name="address" placeholder="Enter address" required><br>
             <br>
        <label for="photo">Profile Photo:</label>
        <input type="file" id="photo" name="photo" accept="image/*" required>

        <button type="submit">Create Student</button>
    </form>
</body>
</html>
